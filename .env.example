# Required for real answers (free key at https://build.nvidia.com). Leave empty for offline mock mode.
NVIDIA_API_KEY=
# Optional: adds live web search to every retrieval query.
PERPLEXITY_API_KEY=

# Optional: point at a self-hosted NIM instead of the hosted API (the only change needed).
# NIM_BASE_URL=http://localhost:8000/v1

# Optional model overrides
# ROUTING_MODEL=meta/llama-3.1-8b-instruct
# CHAT_MODEL=meta/llama-3.3-70b-instruct
# EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
# RERANK_MODEL=nvidia/llama-3.2-nv-rerankqa-1b-v2
# PERPLEXITY_MODEL=sonar
# PERPLEXITY_TIMEOUT=15
